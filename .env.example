# Copy to .env.local (gitignored) and fill in for cloud sync.
# EXPO_PUBLIC_* vars are inlined into the app bundle at build/update time.

# --- Direct mode (simplest: one shared Turso database, no login) ---
EXPO_PUBLIC_TURSO_URL=libsql://your-db.turso.io
EXPO_PUBLIC_TURSO_TOKEN=your-database-auth-token

# --- Accounts mode instead (per-user databases via the Cloudflare Worker) ---
# Set this to the deployed Worker URL and leave the two TURSO_* vars empty.
# EXPO_PUBLIC_SYNC_URL=https://spendly-sync.you.workers.dev
