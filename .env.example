# Copy to .env.local (gitignored) and fill in for cloud sync + login.
# EXPO_PUBLIC_* vars are inlined into the app bundle at build/update time.
#
# Find these in Supabase → Project Settings → API. The anon key is the PUBLIC
# key — safe to ship; Row Level Security guards the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth *Web* client ID (for "Continue with Google"). See GOOGLE_SETUP.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
