{
  "expo": {
    "name": "Spendly",
    "slug": "my-app",
    "owner": "codeflyx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "ee3409d627dcde7839cb6d8eb2b11c176c9e7549",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/6ac93557-ae8d-49bf-8516-96ab9e3499a8",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {},
    "android": {
      "package": "com.codeflyx.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7C4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#081C13"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spendly needs access to your photos so you can attach a receipt to an expense.",
          "cameraPermission": "Spendly needs camera access so you can snap a photo of your receipt."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Spendly uses Face ID to unlock the app."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ac93557-ae8d-49bf-8516-96ab9e3499a8"
      }
    }
  }
}
